{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.hiving.me"
        }
      ],
      "destination": "https://hiving.me/:path*",
      "permanent": true
    },
    {
      "source": "/www/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/media",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/media/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/media/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/talents/jimmy-gressier",
      "destination": "/talents/",
      "permanent": true
    },
    {
      "source": "/talents/jimmy-gressier/",
      "destination": "/talents/",
      "permanent": true
    },
    {
      "source": "/talents/Shana",
      "destination": "https://xy8wkkceax6fodpg.public.blob.vercel-storage.com/hiving-me/talents/Shana",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.(?:mp4|glb))",
      "destination": "https://xy8wkkceax6fodpg.public.blob.vercel-storage.com/hiving-me/:file",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|gif|svg|ico|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|jsx|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
